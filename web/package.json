		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.0.12"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.16.0",
		"@tanstack/svelte-table": "^9.3.1"
